{
  "hosting": {
    "target": "portfolio",
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      { "source": "/matmurti", "destination": "https://khaderhash.github.io/matmurti/", "type": 301 },
      { "source": "/matmurti/", "destination": "https://khaderhash.github.io/matmurti/", "type": 301 },
      { "source": "/matmurti/index.html", "destination": "https://khaderhash.github.io/matmurti/", "type": 301 }
    ],
    "rewrites": [
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|woff2|ttf|otf|png|jpg|jpeg|webp|svg|ico)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "**/*.@(html|json)",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "**/*.@(txt|xml)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=3600" }
        ]
      }
    ]
  }
}
